# PostgreSQL URI from Supabase Connect. Never use the publishable key here.
# DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@db.todfchrydskszdxdastl.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
# Supabase Storage S3 settings. Leave all empty for local media storage.
SUPABASE_STORAGE_BUCKET=
